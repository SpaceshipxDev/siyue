# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local file-db
/data/
/public/uploads/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright / screenshots / one-off scripts at repo root
/.playwright-mcp/
/*.png
/inspect-*.mjs
/make-cookie.mjs

# typescript
*.tsbuildinfo
next-env.d.ts
